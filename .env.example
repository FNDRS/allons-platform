NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# server-only — used by the /api/waitlist endpoint to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Store links used by /events/{id} fallback pages.
# APP_STORE_LINK=https://apps.apple.com/us/app/allons-eventos-honduras/id6780532182?uo=4
# PLAY_STORE_LINK=https://play.google.com/store/apps/details?id=com.fndrs.allons

# Android App Links: use the SHA-256 fingerprint from Google Play App Signing.
# Multiple fingerprints can be comma-separated.
# ANDROID_PACKAGE_NAME=com.fndrs.allons
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:...

# API pública de Allons, usada por /events/{id} para armar la vista previa
# (título, fecha, ciudad y portada del evento). Si falta, se usa el default
# de producción en src/lib/allons-api.ts.
# ALLONS_API_URL=https://uabcpmxq39.us-east-2.awsapprunner.com

# La misma API, pero llamada desde el navegador por la plataforma web
# (/events, /tickets, /comercio). Debe ser pública; sin ella se usa el mismo
# default de producción.
# NEXT_PUBLIC_ALLONS_API_URL=https://uabcpmxq39.us-east-2.awsapprunner.com
