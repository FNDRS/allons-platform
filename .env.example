NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# server-only — used by the /api/waitlist endpoint to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Store links used by /events/{id} fallback pages.
# APP_STORE_LINK=https://apps.apple.com/us/app/allons-eventos-honduras/id6780532182?uo=4
# PLAY_STORE_LINK=https://play.google.com/store/apps/details?id=com.fndrs.allons

# Android App Links: use the SHA-256 fingerprint from Google Play App Signing.
# Multiple fingerprints can be comma-separated.
# ANDROID_PACKAGE_NAME=com.fndrs.allons
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:...

# API pública de Allons, usada por /events/{id} para armar la vista previa
# (título, fecha, ciudad y portada del evento). En `next dev` el default es
# http://127.0.0.1:3000 (allons-api + Postgres local). En producción, sin
# esta variable se usa App Runner.
# ALLONS_API_URL=http://127.0.0.1:3000

# La misma API, pero llamada desde el navegador por la plataforma web
# (/events, /tickets, /comercio).
# NEXT_PUBLIC_ALLONS_API_URL=http://127.0.0.1:3000

# Sentry. Sin DSN no se inicializa, igual que en allons-api.
# Las tres van con NEXT_PUBLIC_ porque el navegador también las necesita y Next
# las incrusta en el build; una variable server-only quedaría undefined ahí.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Sólo para subir source maps en el build (CI / Vercel):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
